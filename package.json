{
  "private": true,
  "sideEffects": false,
  "name": "rango-sdk-monorepo",
  "workspaces": [
    "packages/*",
    "examples/basic/*",
    "examples/main/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "publish": "yarn run rangutopia library publish",
    "postinstall": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.11.18",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "esbuild": "^0.28.0",
    "esbuild-plugins-node-modules-polyfill": "^1.8.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-rango": "^0.0.1",
    "eslint-plugin-destructuring": "^2.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-id-attribute-enforcement": "^1.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.1.0",
    "husky": "^9.1.7",
    "micromatch": "^4.0.8",
    "prettier": "^3.8.3",
    "rangutopia": "^0.3.1",
    "turbo": "^2.9.9",
    "typescript": "^4.9.4"
  },
  "dependencies": {},
  "packageManager": "yarn@1.22.22",
  "repository": {
    "url": "https://github.com/rango-exchange/rango-sdk.git"
  }
}
