{
  "name": "@rango-dev/sdk",
  "version": "0.0.1-next.0",
  "description": "Rango Exchange SDK",
  "license": "GPL-3.0",
  "author": "rango.exchange",
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./adapters/hub3/evm": {
      "types": "./dist/adapters/hub3/evm.d.ts",
      "default": "./dist/adapters/hub3/evm.js"
    },
    "./adapters/hub3/solana": {
      "types": "./dist/adapters/hub3/solana.d.ts",
      "default": "./dist/adapters/hub3/solana.js"
    },
    "./adapters/hub3/starknet": {
      "types": "./dist/adapters/hub3/starknet.d.ts",
      "default": "./dist/adapters/hub3/starknet.js"
    },
    "./adapters/hub3/ton": {
      "types": "./dist/adapters/hub3/ton.d.ts",
      "default": "./dist/adapters/hub3/ton.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rango-exchange/rango-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/rango-exchange/rango-sdk",
  "bugs": {
    "url": "https://github.com/rango-exchange/rango-sdk/issues"
  },
  "scripts": {
    "build": "yarn run rangutopia library build --inputs src/mod.ts,src/adapters/hub3/evm.ts,src/adapters/hub3/solana.ts,src/adapters/hub3/starknet.ts,src/adapters/hub3/ton.ts --splitting",
    "clean": "rm -rf ./dist",
    "test": "vitest run",
    "test:build": "yarn build && vitest run --config vitest.build.config.ts",
    "lint": "eslint src --fix",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ../../.prettierrc.json --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@rango-dev/queue-manager-core": "0.0.0-experimental-4a5bac44-20261029",
    "bignumber.js": "^9.3.1",
    "rango-sdk": "^0.6.0",
    "rango-types": "^0.6.0"
  },
  "peerDependencies": {
    "@hub3js/core": "^0.64.0",
    "@hub3js/evm": "^0.8",
    "@hub3js/solana": "^0.7",
    "@hub3js/starknet": "^0.6",
    "@hub3js/tvm": "^0.6"
  },
  "peerDependenciesMeta": {
    "@hub3js/core": {
      "optional": true
    },
    "@hub3js/evm": {
      "optional": true
    },
    "@hub3js/solana": {
      "optional": true
    },
    "@hub3js/starknet": {
      "optional": true
    },
    "@hub3js/tvm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hub3js/core": "^0.64.0",
    "@hub3js/evm": "^0.8",
    "@hub3js/solana": "^0.7",
    "@hub3js/starknet": "^0.6",
    "@hub3js/tvm": "^0.6",
    "fake-indexeddb": "^6.2.6",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
